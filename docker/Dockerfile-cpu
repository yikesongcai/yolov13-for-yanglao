# YOLOv13 CPU Inference Service - FastAPI based REST API
# Simplified for CPU-only inference deployment

# Use official Python base image
FROM python:3.11.10-slim-bookworm

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Downloads to user config dir (fonts for visualization)
#ADD https://github.com/ultralytics/assets/releases/download/v0.0.0/Arial.ttf \
#    https://github.com/ultralytics/assets/releases/download/v0.0.0/Arial.Unicode.ttf \
#    /root/.config/Ultralytics/

# Install linux packages (minimal for inference only)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /ultralytics

# Copy contents
COPY . .

# Install pip packages (CPU-only PyTorch + ultralytics + FastAPI dependencies)
RUN pip install uv
ENV UV_HTTP_TIMEOUT=600

# Install ultralytics with CPU-only PyTorch (no export extras needed for inference)
RUN uv pip install --system -e . --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-first-match

# Install FastAPI service dependencies and huggingface_hub (required by ultralytics)
RUN pip install --no-cache-dir fastapi uvicorn[standard] python-multipart huggingface_hub

# Download YOLOv13n model for inference (pre-download to avoid startup delay)
RUN python -c "from ultralytics import YOLO; YOLO('yolov13n.pt')"

# Expose port
EXPOSE 8000

# Start the FastAPI service
CMD ["python", "examples/YOLOv13-FastAPI-REST-API/yolov13_fastapi_api.py"]
# Usage Examples -------------------------------------------------------------------------------------------------------

# Build and Push
# t=ultralytics/ultralytics:latest-cpu && sudo docker build -f docker/Dockerfile-cpu -t $t . && sudo docker push $t

# Run
# t=ultralytics/ultralytics:latest-cpu && sudo docker run -it --ipc=host --name NAME $t

# Pull and Run
# t=ultralytics/ultralytics:latest-cpu && sudo docker pull $t && sudo docker run -it --ipc=host --name NAME $t

# Pull and Run with local volume mounted
# t=ultralytics/ultralytics:latest-cpu && sudo docker pull $t && sudo docker run -it --ipc=host -v "$(pwd)"/shared/datasets:/datasets $t
